# URL base de la aplicación bajo prueba
BASE_URL=https://testUrl.com/

# (Opcional) Credenciales de usuario existente para tests de login
# Si no se definen, se usan los valores por defecto en utils/test-data/data.json
EXISTING_USER_EMAIL=
EXISTING_USER_PASSWORD=

# Nivel de logging: debug, info, warn, error, off (default: info)
LOG_LEVEL=info
